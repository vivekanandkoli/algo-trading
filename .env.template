# ──────────────────────────────────────────────────────────────────────────────
#  Zerodha Kite Connect credentials
#  Get API key + secret from: https://developers.kite.trade/
#
#  Setup steps:
#   1. cp .env.template .env
#   2. Fill KITE_API_KEY and KITE_API_SECRET below
#   3. Run: python3 kite_auth.py   (once per day — token expires at midnight)
#   4. Set USE_KITE=true to switch from yfinance to real NSE data
# ──────────────────────────────────────────────────────────────────────────────

KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Auto-filled by kite_auth.py — do not edit manually
KITE_ACCESS_TOKEN=

# Set to true to use real Kite data instead of yfinance
# Leave false for backtesting (free, no auth needed)
USE_KITE=false

# Optional: your app's redirect URL (set in Kite developer console)
KITE_REDIRECT_URL=http://127.0.0.1/
